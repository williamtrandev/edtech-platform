NODE_ENV=development
PORT=4000
LOG_LEVEL=info

SUPABASE_DB_URL=
SUPABASE_DIRECT_URL=
SUPABASE_JWT_SECRET=
SUPABASE_URL=

REDIS_URL=redis://127.0.0.1:6379

# Public URL for links in notification emails (course learn, certificates, etc.)
APP_PUBLIC_URL=http://localhost:5173

# Email: LOG (dev console), SMTP (production), or RESEND (HTTP API)
EMAIL_PROVIDER=LOG
EMAIL_FROM=EdTech Platform <noreply@example.com>

# Required when EMAIL_PROVIDER=SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Required when EMAIL_PROVIDER=RESEND
RESEND_API_KEY=

# --- Payments ---
# Stripe (Hosted Checkout). Leave blank to disable Stripe provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VNPay (VND only). Leave blank to disable VNPay provider.
VNPAY_TMN_CODE=L8G8BMHT
VNPAY_HASH_SECRET=6CB5BNQQUUM6U5JM2QB73DZOI17D0W7F
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Code execution (Piston sandbox) ---
# REQUIRED. The app will not start without it.
#
# There is deliberately no default. It used to fall back to the public
# emkc.org instance, which is shared and heavily rate limited — a handful of
# runs was enough to exhaust it, and grading then silently fell back to manual.
#
# Run your own:
#   docker run -d --name piston --privileged -v piston_data:/piston \
#     -p 2000:2000 ghcr.io/engineer-man/piston
#   curl -X POST localhost:2000/api/v2/packages \
#     -H 'Content-Type: application/json' -d '{"language":"python","version":"3.12.0"}'
PISTON_URL=http://localhost:2000/api/v2

# Set false to skip auto-execution entirely; CODE questions fall back to manual grading.
CODE_EXECUTION_ENABLED=true
# Wall-clock limit (ms) for one execution against one test case.
CODE_EXECUTION_TIMEOUT_MS=8000
# Executions this process may have in flight at once; the rest queue.
CODE_EXECUTION_MAX_CONCURRENCY=4
# Queued executions allowed before new work is rejected instead of piling up.
CODE_EXECUTION_MAX_QUEUE=50
# Tries per execution, including the first, when the sandbox reports a rate limit.
CODE_EXECUTION_RETRY_ATTEMPTS=3
